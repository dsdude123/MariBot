{
  "name": "MariBot (.NET 8)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspaces/MariBot",
  "postCreateCommand": "dotnet restore MariBot-Core/MariBot.Core.csproj MariBot-Core.Tests/MariBot-Core.Tests.csproj MariBot-Common/MariBot.Common.csproj MariBot-Common.Tests/MariBot-Common.Tests.csproj",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit"
      ],
      "settings": {
        "dotnet.defaultSolution": "MariBot.sln"
      }
    }
  },
  "remoteEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1"
  },
  "forwardPorts": [8091]
}
