{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DiscordSettings": {
    "BotToken": "SET-ME",
    "GoogleCloudKey": "SET-ME",
    "GoogleCustomSearchId": "SET-ME",
    "OpenAiApiKey": "SET-ME",
    "OpenAiOrganization": "SET-ME",
    "WolframAlphaAppId": "SET-ME",
    "TwitterApiKey": "SET-ME",
    "TwitterApiKeySecret": "SET-ME",
    "BlackForestLabsApiKey": "SET-ME",
    "GrokApiKey": "SET-ME",
    "IGDBClientId": "SET-ME",
    "IGDBClientSecret": "SET-ME",
    "SleeperCachePath": "sleeper-players.json",
    "Prefix": "zdev"
  },
  "WorkerSettings": {
    "PreSharedKey": "SET-ME",
    "HeartbeatSeconds": 15,
    "OfflineAfterMissedHeartbeats": 3,
    "EvictAfterMissedHeartbeats": 8,
    "DefaultJobTimeoutSeconds": 120,
    "CircuitBreakerFailureThreshold": 3,
    "CircuitBreakerCooldownSeconds": 60,
    "MetricsRetentionDays": 30
  }
}
