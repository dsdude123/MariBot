# Copy to .env (gitignored) for local `docker compose up`, or paste the
# equivalent entries into Portainer's stack environment editor.
#
# Every DiscordSettings__* entry is optional: leave one out and the value baked
# into the image's appsettings.json is used instead. In practice only the bot
# token has to be set for the bot to start.
#
# "__" is .NET's separator for nested config, so DiscordSettings__BotToken
# overrides the DiscordSettings:BotToken key.

# Which published images to run — the tag applies to maribot-core and
# maribot-worker alike, since both are built from the same commit. Use a pr-<n>
# tag to trial a pull request.
MARIBOT_IMAGE_TAG=latest

# Required.
DiscordSettings__BotToken=
# Command prefix. The committed default is "zdev".
DiscordSettings__Prefix=

# Optional — each unlocks the commands that depend on it.
DiscordSettings__GoogleCloudKey=
DiscordSettings__GoogleCustomSearchId=
DiscordSettings__OpenAiApiKey=
DiscordSettings__OpenAiOrganization=
DiscordSettings__WolframAlphaAppId=
DiscordSettings__TwitterApiKey=
DiscordSettings__TwitterApiKeySecret=
DiscordSettings__BlackForestLabsApiKey=
DiscordSettings__GrokApiKey=
DiscordSettings__IGDBClientId=
DiscordSettings__IGDBClientSecret=
DiscordSettings__YahooFantasyClientId=
DiscordSettings__YahooFantasyClientSecret=

# Note: paths inside the container (database, logs, downloads, Yahoo token
# cache) are already set correctly by the image and are not listed here. Change
# where that data lives by moving the volume in docker-compose.yml, not by
# overriding a path.
#
# The worker has nothing to configure here. It holds no API keys, and Core finds
# it through worker-config.json rather than an environment variable — see the
# maribot-worker service in docker-compose.yml.
